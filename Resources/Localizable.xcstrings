    "To paste for you, Clipstack sends ⌘V to the current app, which macOS only allows with Accessibility turned on." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Einsetzen sendet Clipstack ⌘V an die aktuelle App. macOS erlaubt das nur, wenn die Bedienungshilfen aktiviert sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para pegar por ti, Clipstack envía ⌘V a la app actual, algo que macOS solo permite con la accesibilidad activada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour coller à votre place, Clipstack envoie ⌘V à l’app active, ce que macOS n’autorise qu’avec l’accessibilité activée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per incollare al posto tuo, Clipstack invia ⌘V all’app in uso, cosa che macOS consente solo con l’accessibilità attiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clipstackは使用中のアプリに⌘Vを送ってペーストします。macOSでは、アクセシビリティを許可している場合にのみこの操作が可能です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para colar por você, o Clipstack envia ⌘V ao app em uso, o que o macOS só permite com a Acessibilidade ativada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为了替你粘贴，Clipstack 会向当前 App 发送 ⌘V，而 macOS 仅在开启辅助功能后才允许这样做。"
          }
        }
      }
    },
