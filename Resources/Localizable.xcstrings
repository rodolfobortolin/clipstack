    "All unpinned items will be deleted. Pinned items and snippets are kept." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle nicht angehefteten Objekte werden gelöscht. Angeheftete Objekte und Textbausteine bleiben erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán todos los elementos no fijados. Los fijados y los fragmentos se conservan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les éléments non épinglés seront supprimés. Les éléments épinglés et les extraits sont conservés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutti gli elementi non fissati verranno eliminati. Gli elementi fissati e gli snippet restano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ピン留めしていない項目はすべて削除されます。ピン留めした項目とスニペットは残ります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os itens não fixados serão apagados. Os fixados e os snippets continuam."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有未固定的项目都将被删除。已固定的项目和片段会保留。"
