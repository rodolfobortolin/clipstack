    "The pointer menu opens wherever the mouse is, with pinned items, recent items and snippets. The numbers 1 to 0 paste right away." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Menü am Zeiger öffnet sich dort, wo die Maus ist, mit angehefteten und zuletzt kopierten Objekten sowie Textbausteinen. Die Zahlen 1 bis 0 setzen sofort ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El menú del puntero se abre donde esté el ratón, con los elementos fijados, los recientes y los fragmentos. Los números del 1 al 0 pegan al instante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le menu au pointeur s’ouvre là où se trouve la souris, avec les éléments épinglés, récents et les extraits. Les chiffres 1 à 0 collent directement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il menu al puntatore si apre dove si trova il mouse, con gli elementi fissati, i recenti e gli snippet. I numeri da 1 a 0 incollano subito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ポインタ位置のメニューはマウスのある場所に開き、ピン留めした項目、最近の項目、スニペットを表示します。1〜0の数字キーですぐにペーストできます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O menu no cursor abre onde o mouse estiver, com os fixados, os recentes e os snippets. Os números de 1 a 0 colam direto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指针处菜单会在鼠标所在位置打开，显示已固定的项目、最近的项目和片段。按数字 1 到 0 即可立即粘贴。"
          }
        }
      }
    },
    "Title" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
