    "Password managers mark what they copy as confidential. With this on, Clipstack never keeps those items." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passwortmanager markieren, was sie kopieren, als vertraulich. Ist diese Option aktiv, speichert Clipstack solche Objekte nie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los gestores de contraseñas marcan lo que copian como confidencial. Con esta opción, Clipstack nunca guarda esos elementos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les gestionnaires de mots de passe marquent ce qu’ils copient comme confidentiel. Avec cette option, Clipstack ne conserve jamais ces éléments."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I gestori di password contrassegnano ciò che copiano come riservato. Con questa opzione, Clipstack non conserva mai questi elementi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスワードマネージャはコピーした内容を機密として指定します。このオプションをオンにすると、Clipstackはそれらの項目を保存しません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerenciadores de senha marcam o que copiam como confidencial. Com essa opção, o Clipstack nunca guarda esses itens."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密码管理器会将其拷贝的内容标记为机密。开启此选项后，Clipstack 绝不会保存这些项目。"
          }
        }
      }
    },
