    "Glass uses Liquid Glass on macOS 26. Earlier versions get a translucent background instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glas verwendet Liquid Glass unter macOS 26. Ältere Versionen zeigen stattdessen einen durchscheinenden Hintergrund."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El vidrio usa Liquid Glass en macOS 26. Las versiones anteriores muestran un fondo translúcido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le verre utilise Liquid Glass sous macOS 26. Les versions antérieures affichent un fond translucide."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il vetro usa Liquid Glass su macOS 26. Le versioni precedenti mostrano uno sfondo traslucido."
